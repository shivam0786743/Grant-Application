# ============================================================
# Backend Environment Variables — Render pe set karein
# Render Dashboard → Service → Environment → Add Environment Variable
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# MongoDB — MongoDB Atlas free cluster URL use karein
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/grant_completeness_db?retryWrites=true&w=majority

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Vercel Frontend URL (CORS whitelist) — apna Vercel URL daalo
FRONTEND_URL=https://your-frontend.vercel.app

# Max file upload size (15MB = 15728640 bytes)
MAX_FILE_SIZE_BYTES=15728640
